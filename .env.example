# Example credentials for the Rhiza forecasting skills.
# Copy this file to .env and fill in your own values:  cp .env.example .env
# Do not commit your filled-in .env.

# ecmwf-fetch — ECMWF S2S forecasts via the ECMWF Data Stores (ECDS)
ECMWF_DATASTORES_URL=https://ecds.ecmwf.int/api
ECMWF_DATASTORES_KEY=

# imerg-fetch — NASA Earthdata (urs.earthdata.nasa.gov)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# tahmo-fetch — TAHMO station API
TAHMO_API_USERNAME=
TAHMO_API_PASSWORD=

# chirps-fetch requires no credentials (anonymous CHIRPS FTP).
